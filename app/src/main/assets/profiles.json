  "brandRecipes": {
    "xiaomi": {
      "entry": "设置 > 省电与电池 > 性能模式（或 游戏加速 / 狂暴模式）",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "POWER_PERFORMANCE_MODE_OPEN",
            "POWER_BALANCED_MODE_OPEN",
            "speed_mode"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "power_performance_mode",
            "force_high_performance"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "HyperOS/MIUI 版本差异大。settings 键为社区候选，必须先 settings list 探测；未命中就引导用户到系统入口，不要盲目直写。"
    },
    "oppo": {
      "entry": "设置 > 电池 > 更多 > 高性能模式（一加官方入口）",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "high_performance_mode",
            "perf_mode",
            "game_mode_performance"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "oplus_high_performance",
            "high_performance_mode_enable"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "ColorOS 需关闭『权限监控』才能完整使用 ADB 能力（该开关由用户在系统里操作，应用无法代劳）。"
    },
    "realme": {
      "entry": "设置 > 电池 > 高性能模式（realme UI 与 ColorOS 同源）",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "high_performance_mode",
            "perf_mode"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "realme_high_performance"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "与 ColorOS 共用候选键，先探测后写入。"
    },
    "vivo": {
      "entry": "设置 > 电池 > 省电与性能 > Monster / 性能模式（游戏魔盒内也有开关）",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "vivo_performance_mode",
            "monster_mode",
            "performance_mode"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "vivo_game_mode",
            "high_performance_mode"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "OriginOS/Funtouch 底层键未公开。禁止冻结 i 管家或游戏组件，会破坏通知与网络加速。"
    },
    "honor": {
      "entry": "设置 > 电池（或 系统管家 > 电池）> 性能模式，开启后状态栏出现图标",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "performance_mode",
            "power_mode_performance"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "honor_performance_mode"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "官方入口已确认存在；没有可写的公开系统键，探测不到就回退手动入口。"
    },
    "samsung": {
      "entry": "Game Booster > 性能档位（性能 / 标准 / 省电）",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "game_performance_mode",
            "sem_performance_mode"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "game_booster_performance"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "Game Booster 档位是官方能力；全局性能属性未确认，建议只对前台游戏生效。"
    },
    "other": {
      "entry": "系统设置 > 电池 / 性能相关入口",
      "candidates": [
        {
          "ns": "system",
          "keys": [
            "performance_mode",
            "high_performance_mode"
          ],
          "on": "1",
          "off": "0"
        },
        {
          "ns": "global",
          "keys": [
            "performance_mode"
          ],
          "on": "1",
          "off": "0"
        }
      ],
      "notes": "未收录品牌：只做只读监控 + 通用候选键探测 + 通用 sysfs 配方（root）。"
    }
